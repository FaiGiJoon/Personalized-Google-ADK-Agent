# Copy this file to .env and fill in your key.
# The agent reads these at startup (via python-dotenv).

# Option A: Google AI Studio API key (simplest)
GOOGLE_API_KEY=your-gemini-api-key-here

# Option B: Vertex AI on Google Cloud (uncomment to use instead of the key above)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
